<!doctype html>
<html lang="{{ site.language }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <meta name="theme-color" content="#f8f7f3">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ site.name }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:type" content="{% if section == 'note' %}article{% else %}website{% endif %}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/assets/css/style.css">
    {% if section == 'blog' %}<script src="/assets/js/search.js" defer></script>{% endif %}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="{{ site.name }} — Home">{{ site.name }}<span class="brand-dot" aria-hidden="true">.</span></a>
      <nav aria-label="Main navigation">
        <a href="/" {% if section == 'home' %}aria-current="page"{% endif %}>Home</a>
        <a href="/article/" {% if section == 'article' %}aria-current="page"{% endif %}>Article</a>
        <a href="/blog/" {% if section == 'blog' or section == 'note' %}aria-current="{% if section == 'note' %}true{% else %}page{% endif %}"{% endif %}>Blog</a>
      </nav>
    </header>
    <main id="main" class="shell{% if section == 'article' %} publications-page{% endif %}"{% if section == 'article' %} aria-label="Publications"{% endif %}>{{ content | safe }}</main>
    <footer class="site-footer shell">
      <p>© {{ site.name }}</p>
      <a href="{{ site.github }}">GitHub <span aria-hidden="true">↗</span></a>
    </footer>
  </body>
</html>
