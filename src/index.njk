---
layout: base.njk
section: home
---
<section class="hero" aria-labelledby="home-title">
  <div class="hero-copy">
    <h1 id="home-title">{{ site.name }}<span class="brand-dot">.</span></h1>
    <dl class="profile-education" aria-label="Education">
      {% for item in site.education %}
      <div class="profile-education-row">
        <dt>{{ item.label }}</dt>
        <dd><strong>{{ item.institution }}</strong><span>{{ item.detail }}</span></dd>
      </div>
      {% endfor %}
    </dl>
    <div class="profile-research" aria-labelledby="research-title">
      <h2 id="research-title">Research interests</h2>
      <ul>{% for interest in site.researchInterests %}<li>{{ interest }}</li>{% endfor %}</ul>
    </div>
    {% if site.email %}<div class="hero-links"><a class="subtle-link" href="mailto:{{ site.email }}">Email me <span aria-hidden="true">↗</span></a></div>{% endif %}
  </div>
</section>
<section class="recent-section" aria-labelledby="recent-title">
  <div class="section-heading"><h2 id="recent-title"><a href="/blog/">Blog</a></h2></div>
  <div class="month-grid">
    {% for month in collections.notes | monthGroups %}
    <a class="month-card" href="/blog/?year={{ month.year }}&amp;month={{ month.month }}">
      <span class="month-year">{{ month.year }}</span>
      <span class="month-name">{{ month.label }}<span aria-hidden="true">↗</span></span>
      <span class="month-count">{{ month.count }} {% if month.count == 1 %}post{% else %}posts{% endif %}</span>
    </a>
    {% endfor %}
  </div>
</section>
